# OBRIGATÓRIO: Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# URL oficial para OAuth e metadados
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Fish Audio (backend only); vozes autorizadas são cadastradas na tabela voice_catalog
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro
# Worker de imagem/vídeo externo (obrigatório para gerar mídia visual)
# Ative somente quando ComfyUI + worker estiverem funcionando no RunPod
GPU_QUEUE_ENABLED=false
# O worker faz polling autenticado no Supabase; nao e necessario endpoint HTTP publico.
# Não configure valores inventados; pagamento real ainda não incluído

# BytePlus ModelArk - disabled by default
BYTEPLUS_API_KEY=
BYTEPLUS_GENERATION_ENABLED=false
BYTEPLUS_REGION=ap-southeast

# V2.4: somente para administrador de teste, após confirmar saldo/custos da BytePlus.
# Use o UUID REAL do administrador autenticado no Supabase, nunca email editável do cliente.
ADMIN_USER_ID=
BYTEPLUS_VIDEO_TEST_ENABLED=false
